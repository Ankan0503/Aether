node_modules/
dist/
.env
__pycache__/
*.pyc
backend/models/

# Local editor/session config, not part of the project.
.claude/

# Capture images are regenerable; captures.csv is NOT - identify.py matches
# live readings against it, so the reference waveforms must stay in the repo.
backend/captures/*.png

# Firmware credentials - MQTT broker user/pass. Never commit.
firmware/**/secrets.h

# Python virtual environments - rebuilt from requirements.txt, never committed.
venv/
.venv/

# Django's local SQLite file. The project runs on Tiger Cloud; a stray sqlite
# file in the repo only invites someone to run against the wrong database.
db.sqlite3

# Matplotlib output from the bench tools.
backend/captures/*.csv.bak

# Firmware build artifacts
firmware/**/build/
firmware/**/out_kitchen/
*.bin
*.elf
*.map

