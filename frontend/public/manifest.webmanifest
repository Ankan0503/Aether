{
  "name": "AETHER Smart Home Automation",
  "short_name": "AETHER",
  "description": "AETHER mesh safety, energy, and automation dashboard.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "fullscreen", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#f7f4ea",
  "theme_color": "#51662b",
  "categories": ["productivity", "utilities"],
  "shortcuts": [
    {
      "name": "Safety Hub",
      "short_name": "Safety",
      "description": "Open AETHER safety monitoring.",
      "url": "/?view=safety",
      "icons": [
        {
          "src": "/icons/aether-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Manual Control",
      "short_name": "Controls",
      "description": "Open AETHER manual device controls.",
      "url": "/?view=controls",
      "icons": [
        {
          "src": "/icons/aether-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "icons": [
    {
      "src": "/aether-logo.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/aether-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/aether-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
